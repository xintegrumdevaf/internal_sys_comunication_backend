# --- App ---
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=https://your-public-domain.example.com

# --- Postgres (ver docker-compose.yml) ---
DB_USER=isp
DB_PASSWORD=isp
DB_NAME=isp_platform
DATABASE_URL=postgres://isp:isp@localhost:5432/isp_platform

# --- n8n Infrastructure ---
N8N_DB_NAME=n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# --- Redis (ver docker-compose.yml) — colas, buffer/debounce, locks ---
REDIS_URL=redis://localhost:6379

# --- Seguridad interna API -> n8n (docs/spec/03_API_CONTRACT.md §F) ---
API_INTERNAL_KEY=replace-with-a-long-random-secret

# --- CORS para el frontend (docs/API_ENDPOINTS.md) ---
# Lista separada por comas, ej: http://localhost:8080,http://localhost:8082
# Vacío + NODE_ENV=development => refleja cualquier origin (conveniencia local).
# Vacío + NODE_ENV=production => no se permite ningún origin (configurar explícito).
CORS_ALLOWED_ORIGINS=

# --- Login real / sesiones (docs/spec/06_BACKEND_GAPS.md §1.b) ---
# Duracion de la sesion en segundos, con expiracion deslizante (se renueva en
# cada request autenticado). 43200 = 12 horas de inactividad.
SESSION_TTL_SECONDS=43200

# --- Auto-asignacion de casos escalados (docs/spec/06_BACKEND_GAPS.md §2) ---
AUTO_ASSIGN_MAX_ACTIVE_CASES_PER_AGENT=6

# --- WhatsApp Business Cloud / Meta Templates API ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_WABA_ID=
META_ACCESS_TOKEN=

# --- IA (AIProviderPort, docs/spec/03_API_CONTRACT.md §A) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_EMBEDDING_DIMENSION=2560
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
AI_CALL_TIMEOUT_MS=45000
# Calidad (Ollama): default 10 min. Los jobs van en cola serial (1 a la vez).
AI_QUALITY_TIMEOUT_MS=600000
# Mensajes customer+agent por tramo de análisis (10–80). Se procesan tramos
# hasta cubrir toda la conversación del caso.
QUALITY_ANALYSIS_CHUNK_SIZE=40

# --- Buffer/debounce de mensajes (docs/spec/02_STATE_MACHINE.md §12) ---
MESSAGE_DEBOUNCE_MS=4500

# --- n8n ---
# Las URLs de cada workflow de acción ya NO van aquí: viven en la tabla
# n8n_workflow_registry (docs/spec/01_DATA_MODEL.md §2), editable en caliente
# vía PUT/DELETE /api/admin/n8n-workflows/:action. Solo el timeout/retries por
# defecto quedan como config global (override por acción vive en la tabla).
N8N_CALL_TIMEOUT_MS=8000
N8N_CALL_MAX_RETRIES=2
# Clave de cifrado de credenciales de n8n (docker-compose). Si cambia, las
# credenciales OAuth (Google Sheets, etc.) dejan de descifrarse y hay que recrearlas.
N8N_ENCRYPTION_KEY=replace-with-a-stable-random-32plus-chars
# --- Microservicio de Diagnóstico MikroTik / OLT (directo, sin n8n) ---
MIKROTIK_SERVICE_URL=http://localhost:3001/api
MIKROTIK_SERVICE_TIMEOUT_MS=35000
