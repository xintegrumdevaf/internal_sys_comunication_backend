# --- App ---
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=https://your-public-domain.example.com

# --- Postgres (ver docker-compose.yml) ---
DATABASE_URL=postgres://isp:isp@localhost:5432/isp_platform

# --- Redis (ver docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Seguridad interna API -> n8n (docs/spec/03_API_CONTRACT.md §F) ---
API_INTERNAL_KEY=replace-with-a-long-random-secret

# --- WhatsApp Business Cloud ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- n8n: registro de acción -> URL, todas SINCRONAS (Webhook -> Respond to Webhook) ---
# URLs de PRODUCCION, nunca /webhook-test/ (ver docs/spec/04_N8N_WORKFLOW_SPEC.md §6)
N8N_WEBHOOK_INTERPRET_MESSAGE=http://localhost:5678/webhook/interpret-message
N8N_WEBHOOK_VALIDATE_CLIENT=http://localhost:5678/webhook/validate-client
N8N_WEBHOOK_CHECK_BALANCE=http://localhost:5678/webhook/check-balance
N8N_WEBHOOK_DIAGNOSTIC=http://localhost:5678/webhook/diagnostic
N8N_WEBHOOK_CONTINUE_DIAGNOSTIC=http://localhost:5678/webhook/continue-diagnostic
N8N_WEBHOOK_RECORD_PAYMENT=http://localhost:5678/webhook/record-payment
N8N_WEBHOOK_APPLY_BANK_ACCOUNT=http://localhost:5678/webhook/apply-bank-account

# Timeouts por llamada saliente hacia n8n (ms) - ver docs/spec/03_API_CONTRACT.md §A/§B.1
N8N_CALL_TIMEOUT_MS=8000
N8N_CALL_MAX_RETRIES=2
