# --- App ---
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=https://your-public-domain.example.com

# --- Postgres (ver docker-compose.yml) ---
DATABASE_URL=postgres://isp:isp@localhost:5432/isp_platform

# --- Redis (ver docker-compose.yml) — colas, buffer/debounce, locks ---
REDIS_URL=redis://localhost:6379

# --- Seguridad interna API -> n8n (docs/spec/03_API_CONTRACT.md §F) ---
API_INTERNAL_KEY=replace-with-a-long-random-secret

# --- WhatsApp Business Cloud ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- IA (AIProviderPort, docs/spec/03_API_CONTRACT.md §A) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
AI_CALL_TIMEOUT_MS=45000

# --- Buffer/debounce de mensajes (docs/spec/02_STATE_MACHINE.md §12) ---
MESSAGE_DEBOUNCE_MS=4500

# --- n8n ---
# Las URLs de cada workflow de acción ya NO van aquí: viven en la tabla
# n8n_workflow_registry (docs/spec/01_DATA_MODEL.md §2), editable en caliente
# vía PUT/DELETE /api/admin/n8n-workflows/:action. Solo el timeout/retries por
# defecto quedan como config global (override por acción vive en la tabla).
N8N_CALL_TIMEOUT_MS=8000
N8N_CALL_MAX_RETRIES=2
# Clave de cifrado de credenciales de n8n (docker-compose). Si cambia, las
# credenciales OAuth (Google Sheets, etc.) dejan de descifrarse y hay que recrearlas.
N8N_ENCRYPTION_KEY=replace-with-a-stable-random-32plus-chars
# Debe coincidir con API_INTERNAL_KEY; n8n la usa en {{ $env.API_INTERNAL_KEY }}
# (ya inyectada al contenedor desde API_INTERNAL_KEY).
