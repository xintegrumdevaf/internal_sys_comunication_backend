    {
      "id": "code-qkb",
      "name": "Format And Wrap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -40],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst docs = items\n  .map((item) => item.json)\n  .filter((j) => j && (j.pageContent || j.document || j.text || j.content || j.metadata));\n\nif (!docs.length) {\n  return [{\n    json: {\n      success: true,\n      result: { found: false },\n      error: null,\n    },\n  }];\n}\n\nconst texts = docs.map((d) => String(d.pageContent || d.document || d.text || d.content || '').trim()).filter(Boolean);\nconst sources = [...new Set(docs.map((d) => {\n  const meta = d.metadata || {};\n  return meta.source || meta.fileName || meta.filename || null;\n}).filter(Boolean))];\n\nreturn [{\n  json: {\n    success: true,\n    result: {\n      found: texts.length > 0,\n      ...(texts.length ? { answer: texts.slice(0, 4).join('\\n\\n'), sources } : {}),\n    },\n    error: null,\n  },\n}];"
      }
    },
